RewriteEngine On
RewriteBase /

# Route only pages that have a finished German counterpart. An explicit English
# choice wins over the Cloudflare country header. No browser-side lookup is made.
RewriteCond %{HTTP:Cookie} (^|;[[:space:]]*)exdox_lang=de(;|$) [NC,OR]
RewriteCond %{HTTP:CF-IPCountry} ^DE$ [NC]
RewriteCond %{HTTP:Cookie} !(^|;[[:space:]]*)exdox_lang=en(;|$) [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^$ /de/ [R=302,L,NE]

RewriteCond %{HTTP:Cookie} (^|;[[:space:]]*)exdox_lang=de(;|$) [NC,OR]
RewriteCond %{HTTP:CF-IPCountry} ^DE$ [NC]
RewriteCond %{HTTP:Cookie} !(^|;[[:space:]]*)exdox_lang=en(;|$) [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^(platform|pricing|faq|company|contact|terms|privacy|data-processing-agreement|subprocessors|data-retention|cookies|account-deletion|register|login|forgot-password)/?$ /de/$1 [R=302,L,NE]

<Files "security.txt">
  ForceType text/plain
</Files>

<IfModule mod_headers.c>
  Header always set Cache-Control "private, no-store" "expr=%{REQUEST_STATUS} == 302"
  SetEnvIf Request_URI "^/de(/|$)" german_preview
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=german_preview
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self' https://www.googletagmanager.com https://accounts.google.com/gsi/client; style-src 'self' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.amazonaws.com; connect-src 'self' https://api.frankfurter.dev https://hz2zkm6jkf.execute-api.eu-west-2.amazonaws.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.google.com https://accounts.google.com/gsi/; frame-src 'self' blob: https://*.amazonaws.com https://accounts.google.com/gsi/; upgrade-insecure-requests"
  <FilesMatch "\.(?:js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:webp|jpg|jpeg|png|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
